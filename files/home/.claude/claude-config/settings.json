{
  "theme": "custom:catppuccin-mocha",
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline.py",
    "padding": 0,
    "refreshInterval": 2
  },
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": ["Thinking"]
  },
  "enabledPlugins": {
    "sidebar@local-mods": true,
    "chat-frames@local-mods": true,
    "jstack@jstack": true
  },
  "extraKnownMarketplaces": {
    "jstack": {
      "source": { "source": "github", "repo": "jweisber/jstack" },
      "autoUpdate": true
    }
  },
  "env": {
    "CLAUDE_CODE_PLUGIN_PREFER_HTTPS": "1"
  }
}
